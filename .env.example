# VisuAIze Environment Variables Example
# Copy to .env and fill in your keys

# AI Provider (groq, gemini, huggingface, ollama)
AI_PROVIDER=groq

# API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Local Ollama (No API Key Required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Paths
OUTPUT_DIR=output
TEMP_DIR=temp

# Firebase Cloud Sync (Chat History & Metadata Backup)
FIREBASE_SERVICE_ACCOUNT=firebase_service_account.json
FIREBASE_DATABASE_URL=https://your-app-default-rtdb.firebaseio.com/
FIREBASE_PROJECT_ID=your-firebase-project-id
